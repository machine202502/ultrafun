        sun_direction: (-0.3, -1.0, -0.4),
        sun_strength: 0.0,
        ambient: 0.1,
    ),
    target_health: 3.0,
    light_scale: 0.0006,
    default_light_range: 14.0,
    arenas: [
        (
            trigger: "arena_casting_trigger",
