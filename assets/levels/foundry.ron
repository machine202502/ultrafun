    (zone: "trigger_shaft_hint", actions: [Say("dispatcher.shaft")]),
        (zone: "trigger_pour_hint", actions: [Say("dispatcher.river_hint")]),
        (zone: "trigger_crossing", actions: [Spawn("bridge"), Say("dispatcher.crossing")]),
        (zone: "trigger_tank", actions: [Say("dispatcher.tank")]),
