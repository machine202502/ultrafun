        (object: "pad_casting_4", launch_speed: 28.0),
        (object: "pad_crane", launch_speed: 25.0),
    ],
    belts: [
        (object: "belt_intro", velocity: (0.0, 0.0, -4.0)),
        (object: "belt_sort_1", velocity: (6.0, 0.0, 0.0)),
        (object: "belt_sort_2", velocity: (-6.0, 0.0, 0.0)),
        (object: "belt_sort_3", velocity: (8.0, 0.0, 0.0)),
        (object: "belt_crane", velocity: (0.0, 0.0, 10.0)),
    ],
    crushers: [
        (object: "crusher_1", travel: 6.0, period_seconds: 2.0, offset_seconds: 0.0),
        (object: "crusher_2", travel: 6.0, period_seconds: 2.0, offset_seconds: 0.4),
        (object: "crusher_3", travel: 6.0, period_seconds: 2.0, offset_seconds: 0.8),
        (object: "crusher_4", travel: 6.0, period_seconds: 2.0, offset_seconds: 1.2),
        (object: "crusher_5", travel: 6.0, period_seconds: 2.0, offset_seconds: 1.6),
    ],
    tubes: [
        (object: "tube_arena_a", exit_speed: 20.0),
        (object: "tube_arena_b", exit_speed: 20.0),
        (object: "tube_crane", exit_speed: 5.0),
    ],
    switches: [
        (
            object: "switch_vent",
            health: 1.0,
            actions: [Open("vent"), Say("dispatcher.vent_open")],
        ),
        (
            object: "switch_furnace",
            health: 1.0,
            actions: [Open("furnace"), Say("dispatcher.furnace_open")],
        ),
        (
            object: "switch_valve",
            health: 1.0,
            actions: [DisableHazard("river"), Spawn("pour"), Say("dispatcher.valve_closed")],
        ),
    ],
    breakables: [
        (group: "catwalk", by_slam: true),
        (group: "shelf", by_slam: true),
        (group: "bridge", by_slam: true),
    ],
    triggers: [
        (zone: "trigger_arrival", actions: [Say("dispatcher.foundry_arrival")]),
        (zone: "trigger_gate_hint", actions: [Say("dispatcher.gate_locked")]),
        (
            zone: "trigger_gate",
